# Security headers for Alsaiti Growth.
#
# GitHub Pages IGNORES this file (it cannot serve custom headers) — it is harmless there.
# Netlify and Cloudflare Pages read it AUTOMATICALLY: deploy this same /docs folder to
# either one and you instantly get the header-level protections that a static host on
# GitHub Pages can't give you (most importantly frame-ancestors, the real clickjacking fix).

/*
  # The FULL policy as a real HTTP header, not only the <meta> tag.
  #
  # A header is enforced before the parser reaches any markup, so it still applies to content
  # injected ahead of the meta tag — and frame-ancestors is ignored in a meta tag by design,
  # which is why clickjacking protection can only live here.
  #
  # Keep this in step with the <meta> CSP in index.html. When both are present the browser
  # enforces the INTERSECTION, so a directive missing here silently tightens the policy and a
  # stray one silently loosens nothing — but drift will still cause confusing breakage.
  #
  # 'unsafe-inline' for scripts is unavoidable: the whole app is one file of inline script.
  # Everything else is locked to 'none' or an explicit allowlist, so an injected <img>, <form>,
  # <iframe> or fetch to a foreign host is refused.
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; connect-src 'self' https://*.supabase.co; media-src data: blob:; base-uri 'none'; form-action 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY

  # Nothing here is meant to be embedded by another origin.
  Cross-Origin-Resource-Policy: same-origin

  # Stop browsers guessing a different content type than we sent.
  X-Content-Type-Options: nosniff

  # Don't leak the URL (which can contain a ?connection= id) to third parties.
  Referrer-Policy: no-referrer

  # Force HTTPS for a year, including subdomains.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # This app needs none of these device APIs — deny them outright.
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # Isolate the browsing context from anything it opens.
  Cross-Origin-Opener-Policy: same-origin

# NOTE: the main Content-Security-Policy (default-src/connect-src/etc.) stays in the
# <meta> tag inside index.html so it also applies on GitHub Pages. Only frame-ancestors
# is repeated here, because frame-ancestors is IGNORED in a meta tag by design.
