# Alsaiti Voice — Edge Function secrets. Set with `supabase secrets set --env-file ./supabase/functions/.env`.
# NONE of these may ever ship to the browser / Expo / git. Fill from provider consoles.
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
#  Supabase runtime — you do NOT set them here; listed for reference only.)

# --- Public URLs the functions need to build redirect + return links ---
PUBLIC_FUNCTIONS_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1
# The origin the app is actually served from. Two things depend on getting this right:
#   * safeReturnUrl() in _shared/http.ts compares an OAuth return URL against it, and discards
#     anything from a different origin. Leave this stale after a domain move and every HubSpot
#     callback bounces the user to the old address.
#   * the "Open your dashboard" link in lead alert emails.
# Update it in the SAME change as the DNS cutover, not afterwards.
PUBLIC_APP_URL=https://alsaitigrowth.com

# --- 32-byte key for envelope-encrypting OAuth tokens (hex = 64 chars, or base64) ---
# Generate: openssl rand -hex 32
OAUTH_CREDENTIAL_ENCRYPTION_KEY=

# --- HubSpot (the reference provider — the one wired end-to-end) ---
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# --- Other CRM providers (authorise flow works once filled; live test/metadata still HubSpot-only) ---
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
HIGHLEVEL_CLIENT_ID=
HIGHLEVEL_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# SALESFORCE_LOGIN_URL=https://test.salesforce.com   # sandbox override
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu          # EU/IN/AU data-centre override
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_MODE=common
# DYNAMICS_RESOURCE=https://YOURORG.crm.dynamics.com

# --- Telnyx (primary phone provider) ---
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=          # portal Ed25519 public key (base64) — required for webhook verification

# --- Human voice (neural TTS). Set ONE of these to make the AI receptionist genuinely lifelike. ---
# ElevenLabs = most human, multilingual (EN/ES/AR), pay per character. Get a key at elevenlabs.io.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_FEMALE=EXAVITQu4vr4xnSDxMaL   # optional: override the default voices
# ELEVENLABS_VOICE_MALE=onwK4e9ZLuTAKqWW03F9
# OpenAI TTS = cheaper, very good. Set this instead if you prefer OpenAI.
OPENAI_API_KEY=
# OPENAI_VOICE_FEMALE=nova
# OPENAI_VOICE_MALE=onyx

# ---- Lead alert emails (lead-notify) ----
# Set ONE of these. Without either, lead-notify returns 501 no_email_provider and the app
# says so honestly instead of pretending an alert was sent.
RESEND_API_KEY=
SENDGRID_API_KEY=
# From address — must be on a domain verified with the provider.
ALERT_FROM_EMAIL=
