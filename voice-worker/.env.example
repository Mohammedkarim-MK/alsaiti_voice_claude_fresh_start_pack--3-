# Alsaiti voice worker — secrets live in the host's secret storage, never in the image (§4.2).

# --- LiveKit ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Supabase (server-side key: this process writes leads) ---
SUPABASE_URL=https://hedaklvumeihfsgokdsi.supabase.co
SUPABASE_SECRET_KEY=

# --- Speech + language ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
TTS_VOICE=nova

# --- Behaviour ---
PORT=8080
SILENCE_MS=7000            # how long to wait before treating quiet as silence
DRAIN_MS=15000             # how long to finish an in-progress call on SIGTERM
DEFAULT_TRANSFER_NUMBER=   # +44... the human to reach for urgent calls; blank disables transfer
TRANSFER_ENABLED=true
TRANSFER_URGENCY=High      # High | Medium | Low — the bar a call must clear to be put through
